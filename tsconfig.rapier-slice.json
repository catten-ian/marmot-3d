{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ESNext.Disposable", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": [
    "experiments/rapier-ts/src/**/*.ts",
    "experiments/rapier-ts/types/**/*.d.ts"
  ]
}
